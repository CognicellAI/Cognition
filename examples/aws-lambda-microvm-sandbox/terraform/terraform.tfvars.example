# Copy to terraform.tfvars and edit for your AWS account.

aws_region = "us-west-2"

# Optional. Leave null to use ambient AWS credentials.
aws_profile = null

# Optional provider safety guard.
allowed_account_ids = ["123456789012"]

prefix = "cognition-microvm"

# Required. This image must already exist and run the Cognition runtime command
# server on runtime_port.
prebuilt_microvm_image_arn     = "arn:aws:lambda:us-west-2:123456789012:microvm-image:cognition-runtime"
prebuilt_microvm_image_version = "1.0"

profile_name = "default-lambda"
runtime_port = 8080

# Cost controls for generated profiles.
maximum_duration_seconds      = 3600
max_concurrent_sessions       = 10
max_session_starts_per_minute = 30
max_idle_duration_seconds     = 900
suspended_duration_seconds    = 300
microvm_logging_mode          = "disabled"
# microvm_logging_mode = "cloudwatch"
# microvm_log_group    = "/aws/lambda-microvms/cognition"
# microvm_log_stream   = "default-lambda"

# Attach the generated control-plane policy to existing Cognition runtime roles.
control_plane_role_names = []

# Add per-agent roles here if agents will use roles other than the default role
# created by this template.
additional_agent_execution_role_arns = []

# Optional VPC-only egress profile.
create_vpc_egress_connector = false
vpc_id                      = null
private_subnet_ids          = []
vpc_egress_cidr_blocks      = []
